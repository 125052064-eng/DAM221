const readline = require('readline');

// ==========================================
// BASE DE DATOS DEL MENÚ DE LA CAFETERÍA
// ==========================================
const menuProductos = [
  { id: 1, nombre: "Café Americano", precio: 40, categoria: "Bebida" },
  { id: 2, nombre: "Cappuccino", precio: 55, categoria: "Bebida" },
  { id: 3, nombre: "Latte Frío", precio: 60, categoria: "Bebida" },
  { id: 4, nombre: "Té Chai", precio: 48, categoria: "Bebida" },
  { id: 5, nombre: "Croissant de Jamón y Queso", precio: 65, categoria: "Alimento" },
  { id: 6, nombre: "Bagel de Pavo", precio: 75, categoria: "Alimento" },
  { id: 7, nombre: "Panini de Pollo", precio: 85, categoria: "Alimento" },
  { id: 8, nombre: "Rebanada de Pastel", precio: 50, categoria: "Alimento" }
];

// Arreglo global de pedidos
const listaPedidos = [];

// Interfaz para la consola
const rl = readline.createInterface({
  input: process.stdin,
  output: process.stdout
});

// ==========================================
// MÓDULO 01: CAJA (Cálculos con reduce y destructuring)
// ==========================================
function calcularTotales() {
  // USO DE .reduce() Y DESTRUCTURING
  const subtotal = listaPedidos.reduce((acum, pedido) => {
    const { precio, cantidad } = pedido; // Destructuring
    return acum + (precio * cantidad);
  }, 0);

  const iva = subtotal * 0.16;
  const total = subtotal + iva;

  return { subtotal, iva, total };
}

function mostrarEstadoCaja() {
  console.clear();
  console.log("==========================================");
  console.log("            ☕ MÓDULO DE CAJA            ");
  console.log("==========================================");
  
  if (listaPedidos.length === 0) {
    console.log("No hay pedidos registrados en la cuenta.\n");
  } else {
    console.log("--- Detalle de la Cuenta ---");
    listaPedidos.forEach((pedido, idx) => {
      const { producto, cantidad, precio } = pedido;
      console.log(`${idx + 1}. ${producto} (x${cantidad}) -> $${(precio * cantidad).toFixed(2)}`);
    });

    const { subtotal, iva, total } = calcularTotales();
    console.log("------------------------------------------");
    console.log(`Subtotal: $${subtotal.toFixed(2)}`);
    console.log(`IVA (16%): $${iva.toFixed(2)}`);
    console.log(`TOTAL A COBRAR: $${total.toFixed(2)}\n`);
  }
}

// ==========================================
// MÓDULO 02: COCINA / BARISTA (Filtros con filter)
// ==========================================
function mostrarCocina(filtro = "todos") {
  console.clear();
  console.log("==========================================");
  console.log("       🍳 MÓDULO COCINA / BARISTA        ");
  console.log("==========================================");

  let pedidosFiltrados = listaPedidos;

  if (filtro === "baratos") {
    pedidosFiltrados = listaPedidos.filter(p => p.precio < 60);
  } else if (filtro === "caros") {
    pedidosFiltrados = listaPedidos.filter(p => p.precio >= 60);
  } else if (filtro === "Bebida" || filtro === "Alimento") {
    pedidosFiltrados = listaPedidos.filter(p => p.categoria === filtro);
  }

  if (pedidosFiltrados.length === 0) {
    console.log("No hay productos que coincidan con la búsqueda.\n");
  } else {
    pedidosFiltrados.forEach(({ producto, cantidad, categoria }) => {
      console.log(`[${categoria.toUpperCase()}] Preparar: ${cantidad}x ${producto}`);
    });
    console.log("\n");
  }
}

// ==========================================
// MÓDULO 03: CLIENTE (Crear pedidos)
// ==========================================
function mostrarMenuProductos() {
  console.log("\n--- Menú disponible ---");
  menuProductos.forEach(prod => {
    console.log(`[ID: ${prod.id}] ${prod.nombre} - $${prod.precio} (${prod.categoria})`);
  });
}

function agregarNuevoPedido() {
  mostrarMenuProductos();
  rl.question("\nIngresa el ID del producto que deseas agregar: ", (idStr) => {
    const idProducto = parseInt(idStr);
    
    // Búsqueda con .find()
    const productoEncontrado = menuProductos.find(p => p.id === idProducto);

    if (!productoEncontrado) {
      console.log("❌ Producto no encontrado.");
      return menuPrincipal();
    }

    rl.question(`Ingresa la cantidad para '${productoEncontrado.nombre}': `, (cantStr) => {
      const cantidad = parseInt(cantStr);

      if (isNaN(cantidad) || cantidad <= 0) {
        console.log("❌ Cantidad inválida.");
      } else {
        listaPedidos.push({
          id: Date.now(),
          producto: productoEncontrado.nombre,
          precio: productoEncontrado.precio,
          categoria: productoEncontrado.categoria,
          cantidad: cantidad
        });
        console.log(`\n✅ ¡${cantidad}x ${productoEncontrado.nombre} agregado con éxito!`);
      }
      menuPrincipal();
    });
  });
}

// ==========================================
// MENÚ PRINCIPAL DE LA TERMINAL
// ==========================================
function menuPrincipal() {
  console.log("\n==========================================");
  console.log("       SISTEMA DE CAFETERÍA (MENÚ)        ");
  console.log("==========================================");
  console.log("1. Módulo Cliente (Agregar Pedido)");
  console.log("2. Módulo Caja (Ver totales e IVA)");
  console.log("3. Módulo Cocina (Ver todos los pedidos)");
  console.log("4. Módulo Cocina (Filtrar Económicos < $60)");
  console.log("5. Módulo Cocina (Filtrar Solo Bebidas)");
  console.log("6. Módulo Cocina (Filtrar Solo Alimentos)");
  console.log("0. Salir");

  rl.question("\nSelecciona una opción: ", (opcion) => {
    switch (opcion.trim()) {
      case "1":
        agregarNuevoPedido();
        break;
      case "2":
        mostrarEstadoCaja();
        menuPrincipal();
        break;
      case "3":
        mostrarCocina("todos");
        menuPrincipal();
        break;
      case "4":
        mostrarCocina("baratos");
        menuPrincipal();
        break;
      case "5":
        mostrarCocina("Bebida");
        menuPrincipal();
        break;
      case "6":
        mostrarCocina("Alimento");
        menuPrincipal();
        break;
      case "0":
        console.log("\n¡Saliendo del sistema! Buen día.");
        rl.close();
        break;
      default:
        console.log("❌ Opción inválida.");
        menuPrincipal();
        break;
    }
  });
}

// Iniciar aplicación
menuPrincipal();